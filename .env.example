# Port the API listens on (inside the container it is always 8080)
PORT=8080

# Shared key the app sends as "Authorization: Bearer <key>". Leave empty only for local development.
API_KEY=

# Redis (docker compose sets this to the bundled redis service)
REDIS_URL=redis://localhost:6379

# Waze accounts the server logs in with. JSON array, one line.
WAZE_ACCOUNTS=[{"username":"","password":""}]

# Optional HTTP proxy for the Waze connection: http://user:pass@host:port
# Waze refuses many datacenter addresses. From a home connection leave this empty.
WAZE_PROXY=

# Minutes an alert is kept after it was last reported
ALERT_TTL_MINUTES=45
